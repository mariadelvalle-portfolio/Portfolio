# Token of the Cloudflare Tunnel configured for mariadelvalle.work.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token

# UID/GID of the host user that owns this checkout.
LOCAL_UID=1000
LOCAL_GID=1000

# Public fetch URL used by the updater container. Keep origin's SSH URL for push.
GIT_FETCH_URL=https://github.com/mariadelvalle-portfolio/Portfolio.git
